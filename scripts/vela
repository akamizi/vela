#!/bin/sh
# Avvia Vela. Funziona dal repository e, una volta installato, da /usr/share/vela.
#   vela                      avvia la shell
#   vela ipc call bar toggle  comandi alla shell in esecuzione (vedi shell/shell.qml)
# Sway lancia i programmi senza ~/.local/bin nel PATH: lì stanno gli script personali usati dal menu.
PATH="$HOME/.local/bin:$PATH"
export PATH
here=$(dirname "$(readlink -f "$0")")
if [ -f "$here/../shell/shell.qml" ]; then
    root="$here/.."
else
    root=${VELA_ROOT:-/usr/share/vela}
fi
if [ "${1:-}" = theme ]; then
    # vela theme qt [write|print|run <programma> [argomenti]]: foglio di stile Qt dal tema di Vela (D-049).
    #   write (default)  salva ~/.local/share/vela/qt/vela.qss e ne stampa il percorso
    #   print            stampa il foglio di stile
    #   run <p> [...]    rigenera il foglio di stile e lancia il programma Qt con `-style fusion -stylesheet` (icone da `qt.iconTheme` di theme.jsonc, solo per quel programma)
    [ "${2:-}" = qt ] || { echo "uso: vela theme qt [write|print|run <programma> [argomenti]]" >&2; exit 2; }
    dir="${XDG_DATA_HOME:-$HOME/.local/share}/vela/qt"; file="$dir/vela.qss"
    action=${3:-write}
    new=$(quickshell ipc -p "$root/shell" call theme qss 2>/dev/null) || new=""
    if [ -n "$new" ]; then
        mkdir -p "$dir"
        printf '%s\n' "$new" > "$file.tmp" && mv "$file.tmp" "$file"
        # Ritocchi dell'utente per provare spazi e padding: ~/.config/vela/qt.qss si aggiunge in coda (vince sulle regole generate)
        extra="${XDG_CONFIG_HOME:-$HOME/.config}/vela/qt.qss"
        [ -r "$extra" ] && { printf '\n/* da %s */\n' "$extra"; cat "$extra"; } >> "$file"
    elif [ ! -r "$file" ]; then
        echo "vela theme qt: Vela non è in esecuzione e non c'è un foglio di stile salvato ($file)" >&2
        exit 1
    fi
    # Icone e palette solo per il programma lanciato: kdeglobals privato (cercato tramite XDG_CONFIG_DIRS) letto dal tema piattaforma «kde» di Qt
    kdedir="$dir/kde"
    kde=$(quickshell ipc -p "$root/shell" call theme kdeglobals 2>/dev/null) || kde=""
    if [ -n "$kde" ]; then
        mkdir -p "$kdedir"
        # Se il tema delle icone scelto non è installato si ripiega su Papirus-Dark (in vela-recommended)
        want=$(printf '%s\n' "$kde" | sed -n 's/^Theme=//p')
        if [ -n "$want" ]; then
            found=0
            for d in "${XDG_DATA_HOME:-$HOME/.local/share}/icons" "$HOME/.icons" /usr/share/icons; do [ -d "$d/$want" ] && found=1; done
            [ "$found" = 1 ] || kde=$(printf '%s\n' "$kde" | sed 's/^Theme=.*/Theme=Papirus-Dark/')
        fi
        printf '%s\n' "$kde" > "$kdedir/kdeglobals"
    fi
    case "$action" in
        write) echo "$file" ;;
        print) cat "$file" ;;
        run)
            [ -n "${4:-}" ] || { echo "vela theme qt run: manca il programma" >&2; exit 2; }
            prog=$4; shift 4
            if [ -r "$kdedir/kdeglobals" ]; then
                # Tema piattaforma «kde» con kdeglobals privato (solo per questo programma): icone da `qt.iconTheme`
                XDG_CONFIG_DIRS="$kdedir:${XDG_CONFIG_DIRS:-/etc/xdg}" XDG_CURRENT_DESKTOP=KDE KDE_SESSION_VERSION=6 QT_QPA_PLATFORMTHEME=kde
            else
                QT_QPA_PLATFORMTHEME=${QT_QPA_PLATFORMTHEME:-gtk3}   # senza tema configurato: icone del tema GTK dell'utente
            fi
            export XDG_CONFIG_DIRS XDG_CURRENT_DESKTOP KDE_SESSION_VERSION QT_QPA_PLATFORMTHEME
            exec "$prog" -style fusion -stylesheet "$file" "$@" ;;
        *) echo "azione sconosciuta: $action" >&2; exit 2 ;;
    esac
    exit 0
fi
# vela files [cartella]: apre la cartella (default: la home) nel gestore di file predefinito; se è PCManFM-Qt lo lancia col tema di Vela.
if [ "${1:-}" = files ]; then
    dir=${2:-$HOME}
    case $(xdg-mime query default inode/directory 2>/dev/null) in
        pcmanfm-qt*) exec "$0" theme qt run pcmanfm-qt "$dir" ;;
        *) exec xdg-open "$dir" ;;
    esac
fi
# vela editor [file]: apre l'editor di testo predefinito (text/plain); se è FeatherPad lo lancia col tema di Vela.
if [ "${1:-}" = editor ]; then
    shift
    app=$(xdg-mime query default text/plain 2>/dev/null)
    case $app in
        featherpad*|FeatherPad*)
            # FeatherPad dipinge l'area di testo con un suo schema colore: al primo avvio (nessun fp.conf) si parte dallo schema scuro
            fp="${XDG_CONFIG_HOME:-$HOME/.config}/featherpad/fp.conf"
            if [ ! -e "$fp" ]; then mkdir -p "$(dirname "$fp")" && printf '[text]\ndarkColorScheme=true\n' > "$fp"; fi
            exec "$0" theme qt run featherpad "$@" ;;
    esac
    if [ -n "$app" ]; then
        for d in "${XDG_DATA_HOME:-$HOME/.local/share}" /usr/local/share /usr/share; do
            if [ -r "$d/applications/$app" ]; then
                if command -v gio >/dev/null 2>&1; then exec gio launch "$d/applications/$app" "$@"; fi
                exec gtk-launch "$app" "$@"
            fi
        done
    fi
    [ $# -gt 0 ] && exec xdg-open "$1"
    echo "vela editor: nessun editor di testo predefinito (xdg-mime default <editor>.desktop text/plain)" >&2; exit 1
fi
if [ "${1:-}" = ipc ]; then
    shift
    exec quickshell ipc -p "$root/shell" "$@"
fi
exec quickshell -p "$root/shell" "$@"
