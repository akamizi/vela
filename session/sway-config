# Configurazione Sway della sessione «Vela» (D-048). Installata dal pacchetto: non va modificata, si aggiorna con il pacchetto.
# Personalizzazioni in ~/.config/vela/sway.d/*.conf (incluse in fondo: le righe dell'utente hanno la precedenza).
# Qui non c'è nessun blocco `bar`: la barra è Vela. Layout di tastiera, sfondo e touchpad si impostano nei file dell'utente
# (per esempio `input type:keyboard { xkb_layout it }`) o dal pannello Impostazioni di Vela.

set $mod Mod4
set $term foot
floating_modifier $mod normal
default_border pixel 1
hide_edge_borders smart

# Sfondo predefinito (gli sfondi di Vela stanno in /usr/share/backgrounds/vela); lo sfondo scelto dall'utente lo sostituisce
output * bg /usr/share/backgrounds/vela/Vela-5.jpg fill

# Avvii della sessione e della shell
exec /usr/libexec/vela/session-init
exec vela

# Applicazioni e finestre
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym Mod1+F4 kill
bindsym $mod+Shift+c reload
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

# Menu, pannelli e layout di Vela
bindsym $mod+Ctrl+m exec vela ipc call menu toggle
bindsym $mod+d exec vela ipc call menu apps
bindsym $mod+Ctrl+a exec vela ipc call menu apps
bindsym $mod+Tab exec vela ipc call layout next
bindsym $mod+Shift+l exec vela ipc call idle lock
bindsym $mod+Shift+e exec vela ipc call session logout
bindsym XF86Display exec vela ipc call panel toggle display

# Focus e spostamento (frecce)
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down

# Disposizione
bindsym $mod+b split horizontal
bindsym $mod+v split vertical
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Spazi di lavoro
bindsym $mod+1 workspace number 1
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+9 move container to workspace number 9

# Tasti multimediali e di schermo (con l'OSD di Vela)
bindsym --locked XF86AudioRaiseVolume exec vela ipc call audio raise
bindsym --locked XF86AudioLowerVolume exec vela ipc call audio lower
bindsym --locked XF86AudioMute exec vela ipc call audio mute
bindsym --locked XF86AudioMicMute exec vela ipc call audio micMute
bindsym --locked XF86MonBrightnessUp exec vela ipc call brightness up
bindsym --locked XF86MonBrightnessDown exec vela ipc call brightness down

# Personalizzazioni dell'utente (ultime: vincono)
include ~/.config/vela/sway.d/*.conf
