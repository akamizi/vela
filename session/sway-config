# Configurazione Sway della sessione «Vela» (D-048). Installata dal pacchetto: non va modificata, si aggiorna con il pacchetto.
# Personalizzazioni in ~/.config/vela/sway.d/*.conf (incluse in fondo: le righe dell'utente hanno la precedenza).
# Qui non c'è nessun blocco `bar`: la barra è Vela. Layout di tastiera, sfondo e touchpad si impostano nei file dell'utente
# (per esempio `input type:keyboard { xkb_layout it }`) o dal pannello Impostazioni di Vela.

set $mod Mod4
set $term foot
floating_modifier $mod normal
default_border pixel 1
hide_edge_borders smart

# Sfondo predefinito (gli sfondi di Vela stanno in /usr/share/backgrounds/vela); lo sfondo scelto dall'utente lo sostituisce
output * bg /usr/share/backgrounds/vela/Vela-5.jpg fill

# Avvii della sessione e della shell
exec /usr/libexec/vela/session-init
exec vela

# Applicazioni
bindsym $mod+Return exec $term
bindsym $mod+t exec vela editor
bindsym $mod+f exec vela files
bindsym $mod+Shift+f exec $term --title="yazi" -e yazi
bindsym $mod+w exec xdg-open http://
bindsym $mod+e exec xdg-open mailto:

# Menu, pannelli e sessione di Vela
bindsym $mod+space exec vela ipc call menu toggle
bindsym $mod+Ctrl+m exec vela ipc call menu toggle
bindsym $mod+Mod1+space exec vela ipc call menu apps
bindsym $mod+d exec vela ipc call menu apps
bindsym $mod+Ctrl+a exec vela ipc call menu apps
bindsym $mod+Shift+space exec vela ipc call menu calc
bindsym Ctrl+$mod+space exec vela ipc call menu power
bindsym $mod+u exec vela ipc call panel toggle user
bindsym $mod+z exec vela ipc call panel toggle shortcuts
bindsym $mod+p exec vela ipc call panel toggle power
bindsym $mod+m exec vela ipc call panel toggle radio
bindsym $mod+Shift+m exec vela ipc call panel toggle music
bindsym $mod+n exec vela ipc call panel toggle subsonic
bindsym $mod+Tab exec vela ipc call layout next
bindsym $mod+l exec vela ipc call idle lock
bindsym $mod+Shift+l exec vela ipc call idle lock
bindsym $mod+i exec vela ipc call panel toggle settings
bindsym $mod+Shift+i exec vela ipc call toggles awake
bindsym $mod+b exec vela ipc call bar toggle
bindsym $mod+Shift+e exec vela ipc call session logout
bindsym XF86Display exec vela ipc call panel toggle display

# Finestre
bindsym $mod+Shift+q kill
bindsym Mod1+F4 kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload
bindsym $mod+Ctrl+f floating toggle
bindsym $mod+F11 fullscreen toggle
bindsym Mod1+Tab focus next sibling
bindsym Mod1+Shift+Tab focus prev sibling
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Spostamento (frecce) e focus (Maiusc + frecce)
bindsym $mod+Left move left 20
bindsym $mod+Right move right 20
bindsym $mod+Up move up 20
bindsym $mod+Down move down 20
bindsym $mod+Shift+Left focus left
bindsym $mod+Shift+Right focus right
bindsym $mod+Shift+Up focus up
bindsym $mod+Shift+Down focus down

# Disposizione
bindsym $mod+h split horizontal
bindsym $mod+v split vertical
bindsym $mod+s layout stacking

# Ridimensiona
mode "resize" {
    bindsym Left resize shrink width 20px
    bindsym Right resize grow width 20px
    bindsym Up resize shrink height 20px
    bindsym Down resize grow height 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Schermate (grim + slurp + swappy): Stamp = area, Maiusc+Stamp = schermo intero
bindsym Print exec sh -c 'grim -g "$(slurp)" - | swappy -f -'
bindsym Shift+Print exec sh -c 'grim - | swappy -f -'

# Cambio spazio di lavoro con Ctrl+Alt+frecce, spostamento della finestra con Maiusc+Alt+frecce
bindsym Ctrl+Mod1+Left workspace prev_on_output
bindsym Ctrl+Mod1+Right workspace next_on_output
bindsym Shift+Mod1+Left move container to workspace prev_on_output; workspace prev_on_output
bindsym Shift+Mod1+Right move container to workspace next_on_output; workspace next_on_output

# Spazi di lavoro
bindsym $mod+1 workspace number 1
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+9 move container to workspace number 9

# Tasti multimediali e di schermo (con l'OSD di Vela)
bindsym --locked XF86AudioRaiseVolume exec vela ipc call audio raise
bindsym --locked XF86AudioLowerVolume exec vela ipc call audio lower
bindsym --locked XF86AudioMute exec vela ipc call audio mute
bindsym --locked XF86AudioMicMute exec vela ipc call audio micMute
bindsym --locked XF86MonBrightnessUp exec vela ipc call brightness up
bindsym --locked XF86MonBrightnessDown exec vela ipc call brightness down

# Personalizzazioni dell'utente (ultime: vincono)
include ~/.config/vela/sway.d/*.conf
