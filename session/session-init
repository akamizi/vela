# Avvii di sessione per la sessione «Vela» (D-048), lanciato da Sway (`exec`). Ogni passo parte solo se il programma c'è e non è già in
# esecuzione; niente di ciò che richiede privilegi o una scelta dell'utente (portachiavi, applet di rete, servizi di sistema).
running() { pgrep -u "$(id -u)" -x "$1" >/dev/null 2>&1; }
runningcmd() { pgrep -u "$(id -u)" -f "^$1( |\$)" >/dev/null 2>&1; }   # per nomi oltre i 15 caratteri (nome del processo troncato)

# I servizi attivati da D-Bus devono vedere il display e l'ambiente di Sway.
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null || true
fi

# Audio (PipeWire; WirePlumber lo avvia la configurazione di PipeWire).
# Si controlla la riga di comando intera: `pipewire -c pipewire-pulse.conf` (figlio del principale, che può restare orfano dopo una
# sessione precedente) ha lo stesso nome del processo e farebbe credere che l'audio sia già avviato.
if command -v pipewire >/dev/null 2>&1 && ! pgrep -u "$(id -u)" -fx 'pipewire|/usr/bin/pipewire' >/dev/null 2>&1; then
    # Un pipewire-pulse orfano tiene occupato il socket di pulse e il PipeWire nuovo non riuscirebbe a servire le app: va fermato prima.
    pkill -u "$(id -u)" -f '^/usr/bin/pipewire -c pipewire-pulse.conf' >/dev/null 2>&1 && sleep 1
    # Il sottoprocesso registra come finisce PipeWire (codice 143 = TERM, 137 = KILL, 139 = crash) in $XDG_RUNTIME_DIR/vela-pipewire.log:
    # se l'audio sparisce a sessione avviata, il motivo si legge lì (il file sparisce allo spegnimento, è in tmpfs).
    plog="${XDG_RUNTIME_DIR:-/tmp}/vela-pipewire.log"
    ( pipewire >"$plog" 2>&1; echo "pipewire uscito con codice $? alle $(date +%T)" >>"$plog" ) &
fi

# Agente polkit (finestra della password per montare dischi, stampanti...) e portale dei selettori di file, entrambi Qt (LXQt): partono
# col tema di Vela (`vela theme qt run`). Il nome dei processi supera i 15 caratteri di `pgrep -x`: si controlla la riga di comando.
# Il portale parte prima di xdg-desktop-portal, altrimenti D-Bus lo attiverebbe senza tema.
if command -v lxqt-policykit-agent >/dev/null 2>&1 && ! runningcmd lxqt-policykit-agent; then
    vela theme qt run lxqt-policykit-agent >/dev/null 2>&1 &
fi
if [ -x /usr/libexec/xdg-desktop-portal-lxqt ] && ! runningcmd /usr/libexec/xdg-desktop-portal-lxqt; then
    vela theme qt run /usr/libexec/xdg-desktop-portal-lxqt >/dev/null 2>&1 &
fi

# Portali per condivisione dello schermo e selettori di file.
if [ -x /usr/libexec/xdg-desktop-portal-wlr ] && ! running xdg-desktop-portal-wlr; then
    /usr/libexec/xdg-desktop-portal-wlr >/dev/null 2>&1 &
fi
if [ -x /usr/libexec/xdg-desktop-portal ] && ! running xdg-desktop-portal; then
    /usr/libexec/xdg-desktop-portal --replace >/dev/null 2>&1 &
fi
exit 0
