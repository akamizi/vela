// Configurazione della shell (default). Gli override stanno in ~/.config/vela/shell.jsonc
// Nessun valore qui dipende da un PC particolare: i sensori si rilevano a runtime.
{
  // Lingua dell'interfaccia: codice a due lettere ("it", "en"…). Vuoto = lingua dell'ambiente, poi italiano.
  // I cataloghi stanno in i18n/<lingua>.json; i propri in ~/.config/vela/i18n/<lingua>.json.
  "language": "",
  "bar": {
    "enabled": true,
    // "top" o "bottom"
    "position": "bottom",
    // Nome dell'uscita che ha la barra (es. "eDP-1", vedi `swaymsg -t get_outputs` o `wlr-randr`); "" = su tutti gli schermi.
    // Se l'uscita non c'è (scollegata) la barra torna su tutti.
    "screen": "",
    // Elementi di ciascuna zona, nell'ordine in cui compaiono. Disponibili:
    // Menu Workspaces WindowLayout WindowTitle Weather Recording Dnd NightLight Awake Media Radio Clock Tray
    // Indicators (raggruppa Recording Dnd NightLight Awake)
    // Memory Cpu Temperature Fan KeyboardLayout Updates Bluetooth Network Vpn Mic Volume Brightness PowerProfile Battery User
    // (WindowLayout compare solo con il demone dati; Mic è spento di default; KeyboardLayout compare solo con più di un layout di tastiera, Updates solo se ci sono aggiornamenti)
    "modules": {
      "left": ["Menu", "Workspaces", "WindowLayout", "Weather", "WindowTitle"],
      "center": ["Indicators", "Media", "Clock"],
      "right": ["Tray", "Memory", "Cpu", "Temperature", "Fan", "KeyboardLayout", "Updates", "Bluetooth", "Network", "Vpn",
                "Volume", "Brightness", "PowerProfile", "Battery", "User"]
    },
    // Gruppi logici: tra elementi di gruppi diversi, vicini nella lista, si lascia groupGap pixel
    // (se manca, il doppio dello spazio del tema). Chi non è elencato fa gruppo con i vicini senza gruppo.
    "groupGap": 14,
    // Elemento Indicators: i simboli dei modi accesi (Recording, Dnd, NightLight, Awake), nell'ordine di "items".
    // peek: con il mouse sulla barra compaiono anche quelli spenti (un clic li accende); alwaysShow: sempre visibili.
    // Con peek il gruppo si allarga: in una zona centrale sposta gli elementi vicini, a sinistra o a destra no.
    "indicators": { "items": ["Recording", "Dnd", "NightLight", "Awake"], "alwaysShow": false, "peek": true },
    "groups": {
      "Tray": "tray",
      "Memory": "hw", "Cpu": "hw", "Temperature": "hw", "Fan": "hw",
      "KeyboardLayout": "stato", "Updates": "stato",
      "Bluetooth": "rete", "Network": "rete", "Vpn": "rete",
      "Mic": "audio", "Volume": "audio", "Brightness": "audio",
      "PowerProfile": "energia", "Battery": "energia",
      "User": "utente"
    },
    "workspaces": { "persistent": [1, 2, 3, 4, 5] },
    "windowTitle": { "maxWidth": 360 },
    "media": { "maxWidth": 320 },
    "radio": { "maxWidth": 220 },
    "vpn": { "maxWidth": 200 },
    "clock": {
      // "" = lingua di sistema, altrimenti per esempio "it_IT"
      "locale": "",
      "format": "ddd d MMM  HH:mm",
      "formatAlt": "HH:mm - dd/MM/yyyy"
    }
  },
  "menu": { "enabled": true },
  // Pannelli (si aprono dal menu, dagli elementi della barra o con `vela ipc call panel toggle <nome>`)
  "panels": {
    "network": { "enabled": true },
    "bluetooth": { "enabled": true },
    "audio": { "enabled": true },
    "settings": { "enabled": true },
    "shortcuts": { "enabled": true },
    "radio": { "enabled": true },
    "power": { "enabled": true },
    "battery": { "enabled": true },
    "calendar": { "enabled": true },
    "weather": { "enabled": true },
    "brightness": { "enabled": true },
    "display": { "enabled": true },
    "printers": { "enabled": true },
    "services": { "enabled": true },
    "user": { "enabled": true }
  },
  // Web radio: stazioni [{ "name": "Rai Radio 3", "url": "http://icestreaming.rai.it/3.mp3" }] e player
  // (riceve l'indirizzo come ultimo argomento). Elemento di barra "Radio" e pannello `panel toggle radio`.
  "radio": {
    "stations": [
      { "name": "RTL Radiofreccia", "url": "http://shoutcast.rtl.it:3060/" },
      { "name": "Radio 24", "url": "http://shoutcast.radio24.it:8000/listen.pls" },
      { "name": "LifeGate Radio", "url": "http://onair11.xdevel.com:8024" },
      { "name": "Rai Radio 1", "url": "http://icestreaming.rai.it/1.mp3" },
      { "name": "Rai Radio 2", "url": "http://icestreaming.rai.it/2.mp3" },
      { "name": "Rai Radio 3", "url": "http://icestreaming.rai.it/3.mp3" },
      { "name": "Rai Radio 4 TuttaIta", "url": "http://icestreaming.rai.it/4.mp3" },
      { "name": "Rai Radio 5 Classica", "url": "http://icestreaming.rai.it/5.mp3" },
      { "name": "Rai Radio 6 Techete", "url": "http://icestreaming.rai.it/9.mp3" },
      { "name": "Rai Radio 7 Live", "url": "http://icestreaming.rai.it/10.mp3" },
      { "name": "Rai Radio 8 Opera", "url": "http://icestreaming.rai.it/11.mp3" },
      { "name": "Rai IsoRadio", "url": "http://icestreaming.rai.it/6.mp3" },
      { "name": "Rai GrParlamento", "url": "http://icestreaming.rai.it/7.mp3" },
      { "name": "RTÉ Radio 1", "url": "http://av.rasset.ie/av/live/radio/radio1.m3u" },
      { "name": "RTÉ 2FM", "url": "http://av.rasset.ie/av/live/radio/2fm.m3u" },
      { "name": "RTÉ Lyric FM", "url": "http://av.rasset.ie/av/live/radio/lyric.m3u" },
      { "name": "RTÉ Gold", "url": "http://av.rasset.ie/av/live/radio/gold.m3u" },
      { "name": "Newstalk", "url": "http://pri.gocaster.net/NT.m3u" },
      { "name": "Exclusively Pink Floyd", "url": "https://streaming.exclusive.radio/er/pinkfloyd/icecast.audio" },
      { "name": "Exclusively The Cure", "url": "https://streaming.exclusive.radio/er/thecure/icecast.audio" },
      { "name": "VirginRadio Pink Floyd", "url": "http://icy.unitedradio.it/VirginRogerWaters.mp3" },
      { "name": "Trip Hop Lounge", "url": "https://amoris.sknt.ru:443/triphop" },
      { "name": "Trip Radio", "url": "https://a13.asurahosting.com/listen/trip-radio/radio.mp3" },
      { "name": "Bristol Sound (trip-hop)", "url": "https://thebristolsoundwebradio.stream.laut.fm/thebristolsoundwebradio" }
    ],
    "command": ["mpv", "--no-video", "--no-terminal"]
  },
  "tray": {
    "enabled": true,
    // true = parte chiuso, la freccia lo apre
    "collapsed": true
  },
  "weather": {
    // Servono entrambe le coordinate, altrimenti il meteo resta spento
    "latitude": null,
    "longitude": null,
    "placeName": "",
    // "metric" (°C) oppure "imperial" (°F)
    "units": "metric",
    // api.met.no chiede di identificarsi: meglio aggiungere un contatto, es. "vela/0.1 nome@example.org"
    "userAgent": "vela-shell/0.1",
    "interval": 1800
  },
  "stats": {
    "interval": 5,
    // nome del sensore hwmon da preferire (""= rilevamento automatico)
    "temperatureSensor": "",
    "criticalTemperature": 85,
    // es. ["foot", "-e", "btop"]
    "monitorCommand": null
  },
  // Demone dati (D-039): processo figlio che manda a Vela righe JSON con lo stato di sistema. Se manca o non risponde,
  // i servizi tornano al controllo periodico. "modules": moduli attivi (night: luce notturna; sway: input, layout di tastiera, touchpad).
  "daemon": { "enabled": true, "command": "/usr/libexec/vela/vela-daemon", "modules": ["night", "sway"] },
  // Fine sessione (spegni, riavvia, esci): prima chiude le finestre in ordine e aspetta (closeTimeout, ms) che le app
  // finiscano; se restano finestre aperte l'azione è annullata con una notifica. closeWindows false = azione immediata.
  "session": { "closeWindows": true, "closeTimeout": 10000 },
  // limitHelper: helper di sistema per il limite di carica (compare solo sui portatili compatibili).
  "battery": { "warning": 20, "critical": 10, "limitHelper": "/usr/libexec/vela/battery-limit" },
  "audio": { "step": 0.02, "maxVolume": 1.0 },
  // Aggiornamenti disponibili (elemento "Updates", visibile solo se ce ne sono). Il controllo legge l'indice locale di xbps:
  // si aggiorna dopo una sincronizzazione (`xbps-install -S`, per esempio da un'attività periodica di root).
  // `command` si lancia in un terminale al clic; `interval` in secondi (minimo 60).
  "updates": {
    "enabled": true,
    "interval": 3600,
    "checkCommand": ["xbps-install", "-un"],
    "command": ["foot", "-e", "sh", "-c", "if command -v doas >/dev/null 2>&1; then doas xbps-install -Su; else sudo xbps-install -Su; fi; printf '\\nInvio per chiudere… '; read _"]
  },
  // Servizi runit (D-047): lo stato non richiede privilegi; avvia/ferma/riavvia/abilita/disabilita si lanciano in `terminal` con doas
  // (o sudo), che chiede la password: Vela non la vede. `process` = nome del processo (pgrep -x), se diverso dal servizio.
  "services": {
    "terminal": ["foot", "-e"],
    "list": [
      { "id": "NetworkManager", "label": "Rete (NetworkManager)" },
      { "id": "bluetoothd", "label": "Bluetooth" },
      { "id": "cupsd", "label": "Stampa (CUPS)" },
      { "id": "avahi-daemon", "label": "Scoperta in rete (Avahi)" },
      { "id": "chronyd", "label": "Orologio di rete (chrony)" },
      { "id": "docker", "label": "Docker", "process": "dockerd" },
      { "id": "sshd", "label": "Server SSH" },
      { "id": "unbound", "label": "DNS locale (Unbound)" },
      { "id": "power-profiles-daemon", "label": "Profili energetici" },
      { "id": "touchegg", "label": "Gesti del touchpad (Touchegg)" },
      { "id": "earlyoom", "label": "Protezione dalla memoria esaurita" },
      { "id": "fcron", "label": "Attività pianificate (fcron)" }
    ]
  },
  "brightness": { "step": 5 },
  // OSD di volume e luminosità (sostituisce wob, D-012). Togliere wob dalla configurazione di Sway.
  // Inattività gestita da Vela (D-024). Spenta di default: attivarla solo se non c'è swayidle o simili.
  // Minuti; 0 = mai. `xxxMinutes` vale a batteria, `xxxMinutesOnAc` con l'alimentatore collegato (e sui PC senza batteria).
  // Il comando di blocco è un array di argomenti.
  "idle": {
    // null = automatico: acceso nella sessione «Vela» (blocco, schermo spento, sospensione), spento in un Sway tuo; true/false lo fissano
    "enabled": null,
    "lockMinutes": 5,
    "lockMinutesOnAc": 5,
    "screenOffMinutes": 10,
    "screenOffMinutesOnAc": 10,
    "suspendMinutes": 30,
    "suspendMinutesOnAc": 0,
    "lockCommand": ["swaylock", "-f"]
  },
  "osd": { "enabled": true, "timeout": 1500 },
  // Server di notifiche integrato (sostituisce dunst, D-006). Un solo programma alla volta può possedere
  // org.freedesktop.Notifications: attivarlo solo dopo aver fermato dunst/mako.
  // enabled: notifiche di Vela sempre accese (un altro server, come dunst, va fermato).
  // inVelaSession: accese comunque nella sessione «Vela», dove non c'è altro server; false per tenere dunst anche lì.
  "notifications": { "enabled": false, "inVelaSession": true, "timeout": 6000, "maxVisible": 5 },
  "toggles": {
    // secondi tra un controllo e l'altro degli stati esterni (luce notturna, non disturbare, registrazione)
    "pollInterval": 5,
    "nightTemperature": 4000,
    // comando che esce con 0 se si sta registrando, es. ["cap-record", "is-on"]; null = indicatore spento
    // "Resta sveglio" esterno (facoltativo): comando che esce con 0 se è attivo e comando che lo commuta,
    // es. ["idle-inhibit-toggle", "is-on"] e ["idle-inhibit-toggle"]. Senza, vale l'inibitore interno di Vela.
    "awakeCommand": null,
    "awakeToggleCommand": null,
    "recordingCommand": null,
    // comando per fermare la registrazione, es. ["cap-record", "stop"]
    "recordingStopCommand": null
  }
}
