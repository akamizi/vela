// Configurazione della shell (default). Gli override stanno in ~/.config/vela/shell.jsonc
// Nessun valore qui dipende da un PC particolare: i sensori si rilevano a runtime.
{
  // Lingua dell'interfaccia: codice a due lettere ("it", "en"…). Vuoto = lingua dell'ambiente, poi italiano.
  // I cataloghi stanno in i18n/<lingua>.json; i propri in ~/.config/vela/i18n/<lingua>.json.
  "language": "",
  "bar": {
    "enabled": true,
    // "top" o "bottom"
    "position": "bottom",
    // Elementi di ciascuna zona, nell'ordine in cui compaiono. Disponibili:
    // Menu Workspaces WindowTitle Weather Recording Dnd NightLight Awake Media Radio Clock Tray
    // Memory Cpu Temperature Fan Bluetooth Network Vpn Volume Brightness PowerProfile Battery
    "modules": {
      "left": ["Menu", "Workspaces", "Weather", "WindowTitle"],
      "center": ["Recording", "Dnd", "NightLight", "Awake", "Media", "Clock"],
      "right": ["Tray", "Memory", "Cpu", "Temperature", "Fan", "Bluetooth", "Network", "Vpn",
                "Volume", "Brightness", "PowerProfile", "Battery"]
    },
    "workspaces": { "persistent": [1, 2, 3, 4, 5] },
    "windowTitle": { "maxWidth": 360 },
    "media": { "maxWidth": 320 },
    "radio": { "maxWidth": 220 },
    "vpn": { "maxWidth": 200 },
    "clock": {
      // "" = lingua di sistema, altrimenti per esempio "it_IT"
      "locale": "",
      "format": "ddd d MMM  HH:mm",
      "formatAlt": "HH:mm - dd/MM/yyyy"
    }
  },
  "menu": { "enabled": true },
  // Pannelli (si aprono dal menu, dagli elementi della barra o con `vela ipc call panel toggle <nome>`)
  "panels": {
    "network": { "enabled": true },
    "bluetooth": { "enabled": true },
    "audio": { "enabled": true },
    "settings": { "enabled": true },
    "shortcuts": { "enabled": true },
    "radio": { "enabled": true },
    "power": { "enabled": true },
    "battery": { "enabled": true },
    "calendar": { "enabled": true },
    "brightness": { "enabled": true }
  },
  // Web radio: stazioni [{ "name": "Rai Radio 3", "url": "http://icestreaming.rai.it/3.mp3" }] e player
  // (riceve l'indirizzo come ultimo argomento). Elemento di barra "Radio" e pannello `panel toggle radio`.
  "radio": {
    "stations": [],
    "command": ["mpv", "--no-video", "--no-terminal"]
  },
  "tray": {
    "enabled": true,
    // true = parte chiuso, la freccia lo apre
    "collapsed": true
  },
  "weather": {
    // Servono entrambe le coordinate, altrimenti il meteo resta spento
    "latitude": null,
    "longitude": null,
    "placeName": "",
    // "metric" (°C) oppure "imperial" (°F)
    "units": "metric",
    // api.met.no chiede di identificarsi: meglio aggiungere un contatto, es. "vela/0.1 nome@example.org"
    "userAgent": "vela-shell/0.1",
    "interval": 1800
  },
  "stats": {
    "interval": 5,
    // nome del sensore hwmon da preferire (""= rilevamento automatico)
    "temperatureSensor": "",
    "criticalTemperature": 85,
    // es. ["foot", "-e", "btop"]
    "monitorCommand": null
  },
  // limitHelper: helper di sistema per il limite di carica (compare solo sui portatili compatibili).
  "battery": { "warning": 20, "critical": 10, "limitHelper": "/usr/libexec/vela/battery-limit" },
  "audio": { "step": 0.02, "maxVolume": 1.0 },
  "brightness": { "step": 5 },
  // OSD di volume e luminosità (sostituisce wob, D-012). Togliere wob dalla configurazione di Sway.
  // Inattività gestita da Vela (D-024). Spenta di default: attivarla solo se non c'è swayidle o simili.
  // Minuti; 0 = mai. `xxxMinutes` vale a batteria, `xxxMinutesOnAc` con l'alimentatore collegato (e sui PC senza batteria).
  // Il comando di blocco è un array di argomenti.
  "idle": {
    "enabled": false,
    "lockMinutes": 5,
    "lockMinutesOnAc": 5,
    "screenOffMinutes": 10,
    "screenOffMinutesOnAc": 10,
    "suspendMinutes": 30,
    "suspendMinutesOnAc": 0,
    "lockCommand": ["swaylock", "-f"]
  },
  "osd": { "enabled": true, "timeout": 1500 },
  // Server di notifiche integrato (sostituisce dunst, D-006). Un solo programma alla volta può possedere
  // org.freedesktop.Notifications: attivarlo solo dopo aver fermato dunst/mako.
  "notifications": { "enabled": false, "timeout": 6000, "maxVisible": 5 },
  "toggles": {
    // secondi tra un controllo e l'altro degli stati esterni (luce notturna, non disturbare, registrazione)
    "pollInterval": 5,
    "nightTemperature": 4000,
    // comando che esce con 0 se si sta registrando, es. ["cap-record", "is-on"]; null = indicatore spento
    // "Resta sveglio" esterno (facoltativo): comando che esce con 0 se è attivo e comando che lo commuta,
    // es. ["idle-inhibit-toggle", "is-on"] e ["idle-inhibit-toggle"]. Senza, vale l'inibitore interno di Vela.
    "awakeCommand": null,
    "awakeToggleCommand": null,
    "recordingCommand": null,
    // comando per fermare la registrazione, es. ["cap-record", "stop"]
    "recordingStopCommand": null
  }
}
