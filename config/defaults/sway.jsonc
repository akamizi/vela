// Impostazioni di Sway gestite da Vela (default). Vela non modifica il config di Sway: scrive
// ~/.config/vela/sway.d/vela.conf, che il config di Sway può includere (Impostazioni › Compositor).
// Un valore null significa "non impostato": vale il comportamento predefinito di Sway.
{
  // Per schermo, con il nome di Sway: "eDP-1": { "mode": "1920x1080@60.000Hz", "scale": 1.0, "x": 0, "y": 0,
  // "transform": "normal", "enabled": true }. Si imposta dal pannello (con conferma entro 15 secondi).
  "outputs": {},
  "input": {
    "keyboard": {
      "layout": null,       // es. "it" oppure "it,us"
      "variant": null,
      "options": null,      // es. "grp:alt_shift_toggle,caps:escape"
      "repeatDelay": null,  // millisecondi
      "repeatRate": null    // ripetizioni al secondo
    },
    "touchpad": {
      "tap": null,            // "enabled" | "disabled"
      "naturalScroll": null,  // "enabled" | "disabled"
      "disableWhileTyping": null,
      "accel": null           // -1.0 … 1.0
    }
  },
  // Scorciatoie di Vela: [{ "combo": "$mod+Shift+e", "command": "exec foot" }]. Stessa combinazione di una del
  // config di Sway = la sostituisce; "command": "" la disattiva.
  "keybindings": [],
  // Tasti in più del PC da non associare mai (Copilot compreso): ["$mod+Shift+201", "XF86Favorites"]. Una combinazione già
  // assegnata in ~/.config/vela/sway.d/*.conf o nel config di Sway è comunque rispettata.
  "hardwareOff": [],
  // Programmi da avviare con Sway (richiede l'include nel config di Sway): ["nm-applet --indicator"]
  "autostart": [],
  // Regole per le finestre: [{ "criteria": "[app_id=\"foot\"]", "command": "floating enable" }]
  "rules": [],
  "gaps": {
    "inner": null,         // spazio tra le finestre (px)
    "outer": null,         // spazio dal bordo dello schermo (px)
    "border": null,        // spessore del bordo delle finestre (px, per le nuove)
    "smartGaps": null,     // "on" | "off" | "inverse_outer"
    "smartBorders": null   // "on" | "off" | "no_gaps"
  },
  "wallpaper": {
    "path": null,           // percorso di un'immagine
    "mode": "fill",         // fill | fit | stretch | center | tile
    "color": null           // colore di sfondo "#rrggbb" quando non c'è un'immagine
  }
}
