// Menu di Vela (default). Gli override stanno in ~/.config/vela/menu.jsonc e si fondono per "id":
//   - stesso id: i campi indicati sostituiscono quelli di default ("children" si fonde ricorsivamente)
//   - id nuovo: la voce si aggiunge in fondo
//   - "hidden": true: toglie la voce
// Campi di una voce: id, label, children (sottomenu) oppure action, requires (comandi che devono
// esistere, altrimenti la voce non compare), glyph ("U+F0F85": icona Nerd Font), confirm (chiede conferma).
// Azioni: {"type":"exec","command":[...]} (array di argomenti, mai una stringa da shell),
//         {"type":"toggle","target":"night|awake|dnd|touchpad|bar"}, {"type":"panel","target":"..."},
//         {"type":"compositor","command":"reload"}, {"type":"apps"} (elenco applicazioni),
//         {"type":"idle","command":"lock|suspend"} (blocco col comando di `idle.lockCommand`; la sospensione blocca prima e sospende solo a blocco avvenuto),
//         {"type":"session","command":"logout|reboot|poweroff"} (chiude prima le finestre in ordine, vedi `session` in shell.jsonc).
{
  "items": [
    { "id": "apps", "label": "App", "glyph": "U+F003B", "action": { "type": "apps" } },
    { "id": "files", "label": "File", "glyph": "U+F024B", "requires": ["pcmanfm-qt"], "action": { "type": "exec", "command": ["vela", "theme", "qt", "run", "pcmanfm-qt"] } },
    {
      "id": "toggles", "label": "Interruttori", "glyph": "U+F0521",
      "children": [
        { "id": "night", "label": "Luce notturna", "requires": ["gammastep"], "action": { "type": "toggle", "target": "night" } },
        { "id": "awake", "label": "Resta sveglio", "action": { "type": "toggle", "target": "awake" } },
        { "id": "dnd", "label": "Non disturbare", "action": { "type": "toggle", "target": "dnd" } },
        { "id": "touchpad", "label": "Touchpad", "action": { "type": "toggle", "target": "touchpad" } },
        { "id": "bar", "label": "Barra", "action": { "type": "toggle", "target": "bar" } }
      ]
    },
    {
      "id": "system", "label": "Sistema", "glyph": "U+F0493",
      "children": [
        // I pannelli compaiono quando esistono (fasi 4-6)
        { "id": "settings", "label": "Impostazioni", "action": { "type": "panel", "target": "settings" } },
        { "id": "display", "label": "Schermi", "action": { "type": "panel", "target": "display" } },
        { "id": "printers", "label": "Stampanti", "requires": ["lpstat"], "action": { "type": "panel", "target": "printers" } },
        { "id": "services", "label": "Servizi", "action": { "type": "panel", "target": "services" } },
        { "id": "network", "label": "Rete", "action": { "type": "panel", "target": "network" } },
        { "id": "bluetooth", "label": "Bluetooth", "action": { "type": "panel", "target": "bluetooth" } },
        { "id": "audio", "label": "Audio", "action": { "type": "panel", "target": "audio" } },
        { "id": "shortcuts", "label": "Scorciatoie", "action": { "type": "panel", "target": "shortcuts" } },
        { "id": "weather", "label": "Meteo", "action": { "type": "panel", "target": "weather" } },
        { "id": "calendar", "label": "Calendario", "action": { "type": "panel", "target": "calendar" } },
        { "id": "power-profile", "label": "Energia", "action": { "type": "panel", "target": "power" } },
        { "id": "battery-limit", "label": "Limite di carica", "action": { "type": "panel", "target": "battery" } },
        { "id": "brightness", "label": "Luminosità", "requires": ["brightnessctl"], "action": { "type": "panel", "target": "brightness" } },
        { "id": "radio", "label": "Radio", "requires": ["mpv"], "action": { "type": "panel", "target": "radio" } },
        { "id": "music", "label": "Musica", "requires": ["mpv"], "action": { "type": "panel", "target": "music" } },
        { "id": "subsonic", "label": "Subsonic", "requires": ["mpv"], "action": { "type": "panel", "target": "subsonic" } }
      ]
    },
    {
      "id": "power", "label": "Alimentazione", "glyph": "U+F0425",
      "children": [
        { "id": "lock", "label": "Blocca", "requires": ["swaylock"], "action": { "type": "idle", "command": "lock" } },
        { "id": "suspend", "label": "Sospendi", "requires": ["loginctl"], "action": { "type": "idle", "command": "suspend" } },
        { "id": "logout", "label": "Esci dalla sessione", "confirm": true, "action": { "type": "session", "command": "logout" } },
        { "id": "reboot", "label": "Riavvia", "confirm": true, "requires": ["loginctl"], "action": { "type": "session", "command": "reboot" } },
        { "id": "poweroff", "label": "Spegni", "confirm": true, "requires": ["loginctl"], "action": { "type": "session", "command": "poweroff" } }
      ]
    }
  ]
}
