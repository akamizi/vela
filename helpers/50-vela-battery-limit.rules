// Chi è nel gruppo wheel, in una sessione locale attiva, cambia le soglie di carica senza password.
// L'helper accetta solo "limit on|off" e "full start|stop" (vedi battery-limit).
polkit.addRule(function(action, subject) {
    if (action.id == "org.vela.battery-limit" && subject.local && subject.active && subject.isInGroup("wheel"))
        return polkit.Result.YES;
});
