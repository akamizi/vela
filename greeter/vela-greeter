# Avvia il greeter di Vela (D-055): `cage` (compositor a una sola finestra) con Quickshell e la schermata di accesso.
# È il comando che greetd lancia come utente `_greeter` (vedi greetd-config.toml.example). Impostazioni facoltative in
# /etc/vela-greeter.conf (variabili di shell): XKB_DEFAULT_LAYOUT (default it), VELA_GREETER_WALLPAPER, VELA_GREETER_POWEROFF, VELA_GREETER_REBOOT.
share=${VELA_GREETER_SHARE:-/usr/share/vela-greeter}
[ -r /etc/vela-greeter.conf ] && . /etc/vela-greeter.conf
export XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT:-it}"
# Cartella scrivibile a `_greeter` (cache di Quickshell e Qt, ricordo di utente e sessione)
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/var/cache/vela-greeter}"
export QT_QPA_PLATFORM=wayland
# Nessuna decorazione: cage non le disegna e Qt aggiungerebbe le sue (barra del titolo e bordi) alla finestra a schermo intero
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
[ -n "${VELA_GREETER_WALLPAPER:-}" ] && export VELA_GREETER_WALLPAPER
[ -n "${VELA_GREETER_POWEROFF:-}" ] && export VELA_GREETER_POWEROFF
[ -n "${VELA_GREETER_REBOOT:-}" ] && export VELA_GREETER_REBOOT
# Messaggi di Quickshell, cage e Qt (avvisi, errori innocui) non vanno sul terminale: durante la transizione verso la sessione
# comparirebbero a schermo. Restano nell'ultimo log (si legge come root: doas cat /var/cache/vela-greeter/greeter.log).
log="$XDG_CACHE_HOME/greeter.log"
{ : > "$log"; } 2>/dev/null || log=/dev/null
# Terminale pulito e cursore nascosto: nessun testo vecchio visibile durante lo stacco tra greeter e sessione
printf '\033[2J\033[H\033[?25l' 2>/dev/null
exec cage -s -- quickshell -p "$share" >> "$log" 2>&1
